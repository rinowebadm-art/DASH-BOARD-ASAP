const OWNER = 'rinowebadm-art', REPO = 'DASH-BOARD-ASAP', PATH = 'data.json';
const JOURS = 90;
const NOMS_DATE = ['date diffusion', 'date de diffusion'];
function versDate(x) {
  if (x instanceof Date) return x;
  if (typeof x === 'string') {
    const m = x.trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    if (m) return new Date(+m[3], +m[2] - 1, +m[1]);
    const d = new Date(x);
    if (!isNaN(d)) return d;
  }
  return null;
}
function iso(d) {
  return Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
}
// Convertit une durée (Date 1899) en minutes décimales
function enMinutes(x) {
  if (x instanceof Date) {
    const base = new Date(1899, 11, 30);
    return Math.round((x - base) / 60000 * 100) / 100;
  }
  return x;
}
function lireOnglet(nom, filtrer, duree) {
  const sh = SpreadsheetApp.getActive().getSheetByName(nom);
  if (!sh) throw new Error('Onglet introuvable : ' + nom);
  const v = sh.getDataRange().getValues();
  const h = v.shift();
  let rows = v;
  if (filtrer) {
    const i = h.findIndex(x => NOMS_DATE.indexOf(String(x).trim().toLowerCase()) >= 0);
    if (i < 0) throw new Error('Colonne date introuvable dans ' + nom + ' : ' + JSON.stringify(h));
    const limite = new Date();
    limite.setDate(limite.getDate() - JOURS);
    rows = [];
    v.forEach(r => {
      const d = versDate(r[i]);
      if (d && d >= limite) { r[i] = iso(d); rows.push(r); }
    });
    Logger.log(nom + ' : ' + v.length + ' lues, ' + rows.length + ' gardées. Exemple : ' + JSON.stringify(v[v.length - 1][i]));
  }
  if (duree) {
    rows = rows.map(r => r.map(c => c instanceof Date ? enMinutes(c) : c));
  } else {
    rows = rows.map(r => r.map(c => c instanceof Date ? iso(c) : c));
  }
  return { h: h, r: rows };
}
function publier() {
  const out = {
    Extract: lireOnglet('Extract', true, false),
    DMT: lireOnglet('DMT', false, true),
    Listes: lireOnglet('Listes', false, false),
    NQ: lireOnglet('NQ', true, false),
    ObjectifDMT: lireOnglet('Objectif DMT', false, false),
    ObjectifNQ: lireOnglet('Objectif NQ', false, false)
  };
  const tok = PropertiesService.getScriptProperties().getProperty('GH_TOKEN');
  const url = `https://api.github.com/repos/${OWNER}/${REPO}/contents/${PATH}`;
  const hd = { Authorization: 'token ' + tok };
  let sha;
  try { sha = JSON.parse(UrlFetchApp.fetch(url, { headers: hd }).getContentText()).sha; } catch (e) {}
  UrlFetchApp.fetch(url, {
    method: 'put', headers: hd, contentType: 'application/json',
    payload: JSON.stringify({
      message: 'MAJ auto', sha: sha,
      content: Utilities.base64Encode(JSON.stringify(out), Utilities.Charset.UTF_8)
    })
  });
}
